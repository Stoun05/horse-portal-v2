# Copy this file to .env and configure locally. Never commit .env.
HOST=127.0.0.1
PORT=4100
DATABASE_URL=postgresql://atcylyk_user:CHANGE_ME@127.0.0.1:5432/atcylyk_portal
# Use HOST=0.0.0.0 only after configuring LAN firewall and access controls.
# Generate a random token (at least 32 characters); never commit the real value.
API_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
